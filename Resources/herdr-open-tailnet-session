#!/usr/bin/env bash
set -euo pipefail

host=${1:-}
pane_id=${2:-}
terminal=${3:-Ghostty}
[[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || exit 2
[[ "$pane_id" =~ ^[A-Za-z0-9:._-]+$ ]] || exit 2

case "$terminal" in
  Ghostty|kitty|WezTerm|Alacritty) ;;
  *) terminal=Ghostty ;;
esac

herdr_bin=$(command -v herdr 2>/dev/null || printf '%s/.local/bin/herdr' "$HOME")
ssh -o BatchMode=yes -o ConnectTimeout=4 "$host" \
  '$HOME/.local/bin/herdr' agent focus "$pane_id"

case "$terminal" in
  Ghostty) exec /usr/bin/open -na Ghostty.app --args -e "$herdr_bin" --remote "$host" ;;
  kitty) exec /usr/bin/open -na kitty.app --args "$herdr_bin" --remote "$host" ;;
  WezTerm) exec /usr/bin/open -na WezTerm.app --args start -- "$herdr_bin" --remote "$host" ;;
  Alacritty) exec /usr/bin/open -na Alacritty.app --args -e "$herdr_bin" --remote "$host" ;;
esac
